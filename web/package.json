{
  "name": "ai-support-desk-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity": "vitest run --config vitest.parity.config.ts",
    "export-data": "tsx scripts/exportDataset.ts",
    "export-tuning": "tsx scripts/exportDataset.ts --tuning",
    "export-blind": "tsx scripts/exportBlind.ts",
    "export-weeks": "tsx scripts/exportWeeks.ts",
    "export-fair-pool": "tsx scripts/exportFairPool.ts",
    "export-v2": "tsx scripts/exportV2.ts",
    "measure-answers": "tsx scripts/measureAnswers.ts",
    "measure-two-models": "tsx scripts/measureTwoModels.ts",
    "run-week": "tsx scripts/runWeek.ts",
    "copy-bundle": "tsx scripts/copyBundle.ts",
    "record-web-answers": "tsx scripts/recordWebAnswers.ts",
    "build": "tsx scripts/copyBundle.ts && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "sizes": "tsx scripts/checkSizes.ts",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run sizes"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.21",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  }
}
